# better-auth declares drizzle-kit and vitest as optional peers; resolving them makes npm
# re-flag dev tooling as devOptional, so production audits and `npm prune --omit=dev`
# would keep it. Ignoring peer resolution keeps lockfiles identical across npm 10 and 11.
# Add any peer dependency a new package needs to package.json explicitly.
legacy-peer-deps=true

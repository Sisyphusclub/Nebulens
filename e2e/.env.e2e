# Environment for the end-to-end stack only. Every value here is a throwaway
# placeholder for the mock provider; nothing in this file is a real credential.
APP_VERSION=e2e
IMAGE_API_BASE_URL=http://mock-upstream:4010
IMAGE_API_KEY=e2e-mock-key
# Image analysis also goes to the mock upstream (VISION_API_BASE_URL defaults to it).
VISION_API_KEY=e2e-mock-key
VISION_MODEL=mock-vision
OPENAI_COMPAT_API_KEY=e2e-openai-compat-key
BETTER_AUTH_SECRET=e2e-only-insecure-secret-do-not-reuse
USER_API_KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SEED_DEFAULT_ADMIN=true
FRONTEND_PORT=5180
FRONTEND_ORIGIN=http://localhost:5180
CORS_ORIGIN=http://localhost:5180
BETTER_AUTH_URL=http://localhost:5180

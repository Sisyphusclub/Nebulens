{
  "name": "nebulens-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "stack:up": "docker compose --project-name nebulens-e2e --env-file .env.e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml up -d --build --wait",
    "stack:logs": "docker compose --project-name nebulens-e2e --env-file .env.e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml logs --no-color",
    "stack:down": "docker compose --project-name nebulens-e2e --env-file .env.e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
